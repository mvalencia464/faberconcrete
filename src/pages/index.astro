---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateForm from '../components/EstimateForm.astro';
import { SITE, SERVICES, GUIDES, REVIEWS, HOMEPAGE_FAQS } from '../data/site';

const serviceCards: Record<string, { title: string; badge: string; cta: string }> = {
  driveways: { title: 'Concrete Driveways', badge: '5" Slab + 21AA', cta: 'Explore Driveway Spec' },
  approaches: { title: 'Driveway Approaches', badge: '6" Street Apron', cta: 'Explore Approach Spec' },
  flatwork: { title: 'Concrete Flatwork', badge: '5" Full Depth', cta: 'Explore Flatwork Spec' },
  patios: { title: 'Stamped & Pavers', badge: 'Decorative + Structural', cta: 'Explore Stamped & Pavers' }
};

const countyCards = [
  { slug: 'oakland-county', name: 'Oakland County', detail: 'Farmington Hills, Novi, Troy & more' },
  { slug: 'wayne-county', name: 'Wayne County', detail: 'Livonia, Plymouth, Northville, Canton' },
  { slug: 'macomb-county', name: 'Macomb County', detail: 'Shelby Twp, Sterling Heights, Macomb' },
  { slug: 'washtenaw-county', name: 'Washtenaw County', detail: 'Ann Arbor, Saline, Dexter, Chelsea' },
  { slug: 'livingston-county', name: 'Livingston County', detail: 'Brighton, Howell, Hartland, South Lyon border', wide: true }
];
---

<BaseLayout
  title="Concrete Driveways in Metro Detroit | Faber Concrete"
  description="Faber Concrete pours five-inch driveways and six-inch approaches on compacted 21AA in Wayne, Oakland, Macomb, Washtenaw, and Livingston counties. Not the cheapest bid. Priced down the middle."
  faqs={HOMEPAGE_FAQS}
  howTo={true}
>
  <section class="relative bg-deep text-white overflow-hidden">
    <div
      class="absolute inset-0 opacity-25 pointer-events-none"
      style="background-image: linear-gradient(to right, rgba(216, 223, 218, 0.22) 1px, transparent 1px), linear-gradient(to bottom, rgba(216, 223, 218, 0.22) 1px, transparent 1px), linear-gradient(to right, rgba(216, 223, 218, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(216, 223, 218, 0.08) 1px, transparent 1px), repeating-linear-gradient(45deg, rgba(212, 162, 76, 0.04) 0px, rgba(212, 162, 76, 0.04) 2px, transparent 2px, transparent 12px); background-size: 96px 96px, 96px 96px, 24px 24px, 24px 24px, 100% 100%;"
    >
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20 relative z-10">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/15 text-xs font-semibold tracking-wide text-gold">
            Metro Detroit · Wayne, Oakland, Macomb, Washtenaw &amp; Livingston Counties
          </div>
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold uppercase tracking-tight leading-[1.05]">
            Concrete Driveways in Metro Detroit: <span class="text-accent">Five Inches</span> on Every Driveway.
          </h1>
          <p class="text-base sm:text-lg text-white/85 leading-relaxed max-w-2xl">
            Driveways, approaches, flatwork, stamped concrete, and pavers. <strong>Never a four-inch slab.</strong> Six inches where the street meets the drive. Compacted 21AA crushed aggregate under all of it. This site is only the concrete company.
          </p>
          <div class="grid grid-cols-3 gap-3 sm:gap-4 pt-1 max-w-xl">
            <div class="bg-white/5 border border-white/15 rounded-xl p-3.5">
              <div class="font-display text-2xl sm:text-3xl font-bold text-gold">5 INCH</div>
              <div class="text-xs sm:text-sm font-semibold text-white/90 mt-0.5">Never four</div>
            </div>
            <div class="bg-white/5 border border-white/15 rounded-xl p-3.5">
              <div class="font-display text-2xl sm:text-3xl font-bold text-gold">6 INCH</div>
              <div class="text-xs sm:text-sm font-semibold text-white/90 mt-0.5">On the approach</div>
            </div>
            <div class="bg-white/5 border border-white/15 rounded-xl p-3.5">
              <div class="font-display text-2xl sm:text-3xl font-bold text-gold">21AA</div>
              <div class="text-xs sm:text-sm font-semibold text-white/90 mt-0.5">Compacted base</div>
            </div>
          </div>
          <div class="bg-white/5 border-l-4 border-accent rounded-r-xl p-4 max-w-2xl">
            <p class="text-sm text-white/90 italic">
              “If you are looking for a cheap deal, we are not going to be it. Best quality bid, priced down the middle — with finishers who have more than 25 years on the tools.”
            </p>
            <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-white/75 font-semibold">
              <span>— Matt Faber, Owner</span>
              <span>•</span>
              <span>April &amp; May book first</span>
              <span>•</span>
              <a href="/reviews" class="text-gold underline hover:text-white">★★★★★ 5.0 Google Rating (5 Reviews)</a>
            </div>
          </div>
          <div class="rounded-2xl overflow-hidden border border-white/15 bg-black/40 shadow-2xl">
            <div class="relative aspect-[16/9] max-h-72 w-full overflow-hidden">
              <img
                src="https://media.stokeleads.com/faberconcrete/concrete-crew-finishing-driveway.avif"
                alt="A finisher troweling a fresh concrete driveway beside a stone garage. AI illustration, not a photo of a completed Faber Concrete job."
                class="w-full h-full object-cover"
                width="960"
                height="540"
              />
              <div class="absolute bottom-2 left-2 right-2 bg-deep/90 backdrop-blur-sm text-white/80 text-[11px] px-3 py-1.5 rounded-lg border border-white/10">
                Illustration note: Crew and driveway visuals on this site are AI illustrations showing finishing methods, not photos of a specific completed Faber Concrete job.
              </div>
            </div>
          </div>
        </div>
        <div class="lg:col-span-5">
          <EstimateForm compact={true} />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-panel border-b border-deep/10 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl p-4 border border-deep/10 flex items-center gap-3.5 shadow-sm">
          <div class="w-11 h-11 rounded-lg bg-deep text-gold font-display font-bold text-xl flex items-center justify-center shrink-0">5"</div>
          <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-accent">Driveway Slab</div>
            <div class="font-display text-lg font-bold text-deep leading-tight">Five Inches, Never Four</div>
          </div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-deep/10 flex items-center gap-3.5 shadow-sm">
          <div class="w-11 h-11 rounded-lg bg-deep text-gold font-display font-bold text-xl flex items-center justify-center shrink-0">6"</div>
          <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-accent">Street Apron</div>
            <div class="font-display text-lg font-bold text-deep leading-tight">Six Inches on Approach</div>
          </div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-deep/10 flex items-center gap-3.5 shadow-sm">
          <div class="w-11 h-11 rounded-lg bg-deep text-gold font-display font-bold text-sm flex items-center justify-center shrink-0">21AA</div>
          <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-accent">Under the Slab</div>
            <div class="font-display text-lg font-bold text-deep leading-tight">Graded &amp; Compacted</div>
          </div>
        </div>
        <div class="bg-white rounded-xl p-4 border border-deep/10 flex items-center gap-3.5 shadow-sm">
          <div class="w-11 h-11 rounded-lg bg-deep text-gold font-display font-bold text-[10px] leading-none tracking-tight text-center flex items-center justify-center shrink-0 px-1">25+ YRS</div>
          <div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-accent">The Bid &amp; Crew</div>
            <div class="font-display text-lg font-bold text-deep leading-tight">Priced Down the Middle</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-accent">Concrete Only · Residential &amp; Commercial</span>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold uppercase text-deep mt-2">
          Driveways, Approaches, Flatwork, Stamped Concrete &amp; Pavers
        </h2>
        <p class="text-base text-muted mt-4 leading-relaxed">
          Concrete only, in Wayne, Oakland, Macomb, Washtenaw, and Livingston counties. Fewer companies know how to do this work properly, and a lot of the ones who do never advertise. We keep concrete a dedicated specialty so every slab meets the same structural standard.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {SERVICES.map((service) => {
          const card = serviceCards[service.slug];
          return (
            <article class="bg-white rounded-2xl border border-deep/10 overflow-hidden shadow-sm hover:shadow-xl transition flex flex-col">
              <a href={`/services/${service.slug}`} class="relative h-48 bg-deep overflow-hidden block">
                <img
                  src={service.heroImage.url}
                  alt={service.heroImage.alt}
                  loading="lazy"
                  width="640"
                  height="420"
                  class="w-full h-full object-cover"
                />
                <span class="absolute top-3 left-3 bg-deep/90 text-gold text-xs font-display font-bold uppercase px-2.5 py-1 rounded">
                  {card?.badge}
                </span>
              </a>
              <div class="p-6 flex-1 flex flex-col">
                <h3 class="font-display text-2xl font-bold uppercase text-deep">
                  <a href={`/services/${service.slug}`} class="hover:text-accent transition">
                    {card?.title ?? service.title}
                  </a>
                </h3>
                <p class="text-sm text-muted mt-2.5 flex-1 leading-relaxed">{service.shortDescription}</p>
                <a
                  href={`/services/${service.slug}`}
                  class="mt-5 inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-accent hover:text-accentHover"
                >
                  {card?.cta ?? `Explore ${service.title}`} <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-deep text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-5 space-y-5">
          <span class="text-xs font-bold uppercase tracking-widest text-gold">Homeowner Engineering Comparison</span>
          <h2 class="font-display text-3xl sm:text-4xl font-bold uppercase leading-tight">
            Why the Slab is Thicker: Michigan Cold &amp; 20-Ton Trucks
          </h2>
          <p class="text-sm sm:text-base text-white/80 leading-relaxed">
            Most contractors pour four inches over dirt or a thin layer of sand. Skipping that extra inch saves them <strong>$600 to $700</strong> on an average driveway—what Matt calls <em>“tripping over dollars to pick up pennies.”</em>
          </p>
          <p class="text-sm sm:text-base text-white/80 leading-relaxed">
            A thin slab rarely fails in year one. Instead, Michigan freeze-thaw cycles and heavy delivery trucks crack it early so you live with a driveway you hate long before you are ready to tear it out.
          </p>
          <div class="pt-2 flex flex-wrap gap-3">
            <button id="btn-spec-faber" type="button" class="px-4 py-2.5 rounded-xl bg-accent text-white font-display font-bold uppercase text-sm tracking-wider shadow-lg transition cursor-pointer">
              Faber Concrete Spec (5" / 6" + 21AA)
            </button>
            <button id="btn-spec-cheap" type="button" class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-display font-bold uppercase text-sm tracking-wider border border-white/15 transition cursor-pointer">
              Typical Low Bid (4" on Sand/Dirt)
            </button>
          </div>
          <a href="/calculator" class="inline-flex items-center gap-2 text-sm font-bold text-gold hover:underline">
            Open Full Driveway &amp; Approach Cost Calculator →
          </a>
        </div>
        <div class="lg:col-span-7">
          <div id="slab-visualizer-card" class="bg-white/5 border border-white/15 rounded-2xl p-6 sm:p-8 shadow-2xl">
            <div class="flex flex-wrap items-center justify-between gap-2 pb-4 mb-6 border-b border-white/10">
              <div>
                <span id="viz-badge" class="inline-block px-2.5 py-0.5 rounded bg-accent text-white text-xs font-bold uppercase tracking-wider">Faber Standard</span>
                <h3 id="viz-title" class="font-display text-2xl font-bold uppercase mt-1">5" Driveway / 6" Approach on Compacted 21AA</h3>
              </div>
              <div class="text-right">
                <div class="text-xs text-white/60 uppercase font-semibold">Freeze-Thaw &amp; Load Rating</div>
                <div id="viz-rating" class="font-display text-xl font-bold text-gold">20-Ton Truck Ready</div>
              </div>
            </div>
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs font-semibold text-white/70 px-2">
                <span>↑ Surface: Hand-troweled &amp; broom-finished by 25+ yr finishers</span>
                <span id="viz-load-note" class="text-gold">Heavy Load Distributed</span>
              </div>
              <div id="viz-concrete-layer" class="rounded-xl bg-gradient-to-r from-stone-300 via-stone-200 to-stone-300 text-deep p-5 border-2 border-white shadow-inner transition-all duration-300">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-accent">Layer 1 · Structural Concrete Slab</span>
                    <div id="viz-concrete-thickness" class="font-display text-2xl font-bold uppercase">5.0 Inches (Driveway) / 6.0 Inches (Approach)</div>
                  </div>
                  <span id="viz-concrete-tag" class="px-3 py-1 rounded-lg bg-deep text-white text-xs font-bold">+25% to +50% More Concrete Depth</span>
                </div>
                <p id="viz-concrete-desc" class="text-xs text-deep/80 mt-2 font-medium">
                  Full five-inch slab across the entire driveway and six inches at the street apron prevents flexural cracking under delivery trucks and winter heave.
                </p>
              </div>
              <div id="viz-base-layer" class="rounded-xl bg-amber-900/40 border-2 border-gold/50 p-4 transition-all duration-300">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-gold">Layer 2 · Sub-Base Preparation</span>
                    <div id="viz-base-title" class="font-display text-xl font-bold uppercase text-white">Graded &amp; Mechanically Compacted 21AA Crushed Aggregate</div>
                  </div>
                  <span id="viz-base-tag" class="px-2.5 py-1 rounded bg-gold/20 text-gold text-xs font-bold">Zero Washout Risk</span>
                </div>
                <p id="viz-base-desc" class="text-xs text-white/80 mt-1.5">
                  Angular 21AA stone locks together under compaction and drains properly through Michigan freeze-thaw cycles without eroding out from under the slab.
                </p>
              </div>
              <div class="rounded-xl bg-stone-900/80 border border-white/10 p-3.5 text-xs text-white/70">
                <strong>Layer 3 · Native Michigan Subgrade:</strong> Excavated &amp; graded to proper pitch before 21AA placement (Never poured directly on dirt).
              </div>
            </div>
            <div class="mt-6 pt-5 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <img src={SITE.methodInfographic.url} alt={SITE.methodInfographic.alt} class="w-16 h-12 object-cover rounded-lg border border-white/20" />
                <p class="text-xs text-white/75">
                  <strong>Every Estimate In Writing:</strong> Slab thickness (5" &amp; 6") and compacted 21AA base are written directly into your contract.
                </p>
              </div>
              <a href="/contact" class="shrink-0 px-4 py-2 rounded-lg bg-white text-deep font-display font-bold text-xs uppercase tracking-wider hover:bg-gold transition">
                Book Site Look
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    function setSlabMode(mode) {
      const btnFaber = document.getElementById('btn-spec-faber');
      const btnCheap = document.getElementById('btn-spec-cheap');
      const on = 'px-4 py-2.5 rounded-xl bg-accent text-white font-display font-bold uppercase text-sm tracking-wider shadow-lg transition cursor-pointer';
      const off = 'px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-display font-bold uppercase text-sm tracking-wider border border-white/15 transition cursor-pointer';
      if (mode === 'faber') {
        btnFaber.className = on;
        btnCheap.className = off;
        document.getElementById('viz-badge').textContent = 'Faber Standard';
        document.getElementById('viz-badge').className = 'inline-block px-2.5 py-0.5 rounded bg-accent text-white text-xs font-bold uppercase tracking-wider';
        document.getElementById('viz-title').textContent = '5" Driveway / 6" Approach on Compacted 21AA';
        document.getElementById('viz-rating').textContent = '20-Ton Truck Ready';
        document.getElementById('viz-rating').className = 'font-display text-xl font-bold text-gold';
        document.getElementById('viz-concrete-layer').className = 'rounded-xl bg-gradient-to-r from-stone-300 via-stone-200 to-stone-300 text-deep p-5 border-2 border-white shadow-inner transition-all duration-300';
        document.getElementById('viz-concrete-thickness').textContent = '5.0 Inches (Driveway) / 6.0 Inches (Approach)';
        document.getElementById('viz-concrete-tag').textContent = '+25% to +50% More Concrete Depth';
        document.getElementById('viz-concrete-desc').textContent = 'Full five-inch slab across the entire driveway and six inches at the street apron prevents flexural cracking under delivery trucks and winter heave.';
        document.getElementById('viz-base-layer').className = 'rounded-xl bg-amber-900/40 border-2 border-gold/50 p-4 transition-all duration-300';
        document.getElementById('viz-base-title').textContent = 'Graded & Mechanically Compacted 21AA Crushed Aggregate';
        document.getElementById('viz-base-tag').textContent = 'Zero Washout Risk';
        document.getElementById('viz-base-desc').textContent = 'Angular 21AA stone locks together under compaction and drains properly through Michigan freeze-thaw cycles without eroding out from under the slab.';
      } else {
        btnCheap.className = on;
        btnFaber.className = off;
        document.getElementById('viz-badge').textContent = 'Typical Low-Ball Shortcut';
        document.getElementById('viz-badge').className = 'inline-block px-2.5 py-0.5 rounded bg-red-600 text-white text-xs font-bold uppercase tracking-wider';
        document.getElementById('viz-title').textContent = '4" Thin Slab Poured Over Sand or Bare Dirt';
        document.getElementById('viz-rating').textContent = 'High Early Crack Risk';
        document.getElementById('viz-rating').className = 'font-display text-xl font-bold text-red-400';
        document.getElementById('viz-concrete-layer').className = 'rounded-xl bg-stone-400/80 text-deep p-3.5 border-2 border-red-400 transition-all duration-300';
        document.getElementById('viz-concrete-thickness').textContent = '4.0 Inches (Sometimes 3.5" in High Spots)';
        document.getElementById('viz-concrete-tag').textContent = 'Saves ~$600–$700 Upfront';
        document.getElementById('viz-concrete-desc').textContent = 'Skipping 1 inch on the drive and 2 inches on the apron leaves the slab vulnerable to delivery trucks and Michigan frost heave.';
        document.getElementById('viz-base-layer').className = 'rounded-xl bg-red-950/50 border border-red-400/50 p-3.5 transition-all duration-300';
        document.getElementById('viz-base-title').textContent = 'Loose Sand or Uncompacted Subgrade Dirt';
        document.getElementById('viz-base-tag').textContent = 'Erosion & Void Risk';
        document.getElementById('viz-base-desc').textContent = 'Sand and topsoil wash out under freeze-thaw water flow, leaving hollow voids where the 4-inch slab snaps.';
      }
    }
    document.getElementById('btn-spec-faber').addEventListener('click', () => setSlabMode('faber'));
    document.getElementById('btn-spec-cheap').addEventListener('click', () => setSlabMode('cheap'));
  </script>

  <section class="py-16 lg:py-20 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-accent">No Curbside Guessing</span>
        <h2 class="font-display text-3xl sm:text-4xl font-bold uppercase text-deep mt-2">
          From the Call to a Finished Slab
        </h2>
        <p class="text-base text-muted mt-3">
          We look at the site, write the spec, then grade and compact 21AA before a single yard of concrete shows up.
        </p>
      </div>
      <div class="grid md:grid-cols-5 gap-4">
        <div class="bg-white rounded-2xl p-5 border border-deep/10 shadow-sm">
          <div class="w-8 h-8 rounded-lg bg-accent text-white font-display font-bold flex items-center justify-center text-sm mb-3">01</div>
          <div class="text-[11px] font-bold uppercase tracking-wider text-muted">The Address</div>
          <h3 class="font-display text-xl font-bold uppercase text-deep mt-0.5">Send the Form</h3>
          <p class="text-xs text-muted mt-2 leading-relaxed">Tell us the service and street address. Some ZIP codes in each county are outside our work area; we confirm right away.</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-deep/10 shadow-sm">
          <div class="w-8 h-8 rounded-lg bg-accent text-white font-display font-bold flex items-center justify-center text-sm mb-3">02</div>
          <div class="text-[11px] font-bold uppercase tracking-wider text-muted">Before a Price</div>
          <h3 class="font-display text-xl font-bold uppercase text-deep mt-0.5">Look at the Site</h3>
          <p class="text-xs text-muted mt-2 leading-relaxed">Matt looks at site grade, drainage, and truck access before pricing anything. A number guessed from the curb is how slabs get poured too thin.</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-deep/10 shadow-sm">
          <div class="w-8 h-8 rounded-lg bg-accent text-white font-display font-bold flex items-center justify-center text-sm mb-3">03</div>
          <div class="text-[11px] font-bold uppercase tracking-wider text-muted">The Spec</div>
          <h3 class="font-display text-xl font-bold uppercase text-deep mt-0.5">Written Estimate</h3>
          <p class="text-xs text-muted mt-2 leading-relaxed">5" driveway, 6" approach, compacted 21AA. Priced down the middle of a quality bid—never a stripped-down lowball number.</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-deep/10 shadow-sm">
          <div class="w-8 h-8 rounded-lg bg-accent text-white font-display font-bold flex items-center justify-center text-sm mb-3">04</div>
          <div class="text-[11px] font-bold uppercase tracking-wider text-muted">Before Forming</div>
          <h3 class="font-display text-xl font-bold uppercase text-deep mt-0.5">The Contract</h3>
          <p class="text-xs text-muted mt-2 leading-relaxed">Matt writes a formal contract, not just a loose estimate. Nothing is formed or poured until you review and approve every detail.</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-deep/10 shadow-sm">
          <div class="w-8 h-8 rounded-lg bg-deep text-gold font-display font-bold flex items-center justify-center text-sm mb-3">05</div>
          <div class="text-[11px] font-bold uppercase tracking-wider text-muted">The Job</div>
          <h3 class="font-display text-xl font-bold uppercase text-deep mt-0.5">Grade, Compact, Pour</h3>
          <p class="text-xs text-muted mt-2 leading-relaxed">Grade the whole area, compact 21AA, form, and pour. Finishers with 25+ years put a clean, durable finish on the slab.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-panel border-y border-deep/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6 space-y-5">
          <span class="text-xs font-bold uppercase tracking-widest text-accent">Metro Detroit Service Footprint</span>
          <h2 class="font-display text-3xl sm:text-4xl font-bold uppercase text-deep">
            Five Counties, Select ZIP Codes
          </h2>
          <p class="text-base text-muted leading-relaxed">
            Based in Farmington Hills, MI, Faber Concrete serves residential and commercial properties across <strong>Wayne, Oakland, Macomb, Washtenaw, and Livingston counties</strong>.
          </p>
          <p class="text-sm text-muted leading-relaxed">
            We focus on specific ZIP codes in each county aimed at property owners who want a five-inch slab on compacted 21AA rather than the cheapest bid in town. Send your address to check scheduling for April, May, and upcoming openings.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            {countyCards.map((county) => (
              <a
                href={`/areas/${county.slug}`}
                class:list={[
                  'flex items-center justify-between p-3.5 rounded-xl bg-white border border-deep/10 hover:border-accent text-left shadow-sm transition',
                  county.wide && 'sm:col-span-2'
                ]}
              >
                <div>
                  <div class="font-display font-bold uppercase text-deep">{county.name}</div>
                  <div class="text-xs text-muted">{county.detail}</div>
                </div>
                <span class="text-accent font-bold shrink-0">{county.wide ? 'Explore County Specs →' : '→'}</span>
              </a>
            ))}
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="bg-white rounded-2xl p-4 border border-deep/10 shadow-lg">
            <div class="rounded-xl overflow-hidden border border-deep/10 h-80 bg-panel">
              <iframe
                title="Faber Concrete Farmington Hills MI Map"
                src={SITE.google.embedUrl}
                class="w-full h-full border-0"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-3 px-1">
              <div>
                <div class="font-display font-bold uppercase text-deep">Faber Concrete — Metro Detroit Dispatch</div>
                <div class="text-xs text-muted">{SITE.address.formatted}</div>
              </div>
              <a
                href={SITE.google.directionsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-3.5 py-2 rounded-lg bg-deep text-white text-xs font-bold uppercase tracking-wider hover:bg-accent transition"
              >
                Directions in Google Maps →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="reviews" class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-accent">Verified Google Business Profile</span>
          <h2 class="font-display text-3xl sm:text-4xl font-bold uppercase text-deep mt-1">
            5.0 Rating from {SITE.google.count} Google Reviews
          </h2>
          <p class="text-sm text-muted mt-1">
            Shown verbatim from the Google Business Profile (listed on Google under Faber’s parent profile).
          </p>
        </div>
        <div class="flex items-center gap-3">
          <a href={SITE.google.profileUrl} target="_blank" rel="noopener noreferrer" class="px-4 py-2.5 rounded-xl border border-deep/15 text-sm font-bold text-deep hover:bg-panel transition">
            View on Google Maps ↗
          </a>
          <a href="/reviews" class="px-4 py-2.5 rounded-xl bg-deep text-white text-sm font-bold hover:bg-accent transition">
            See All Reviews
          </a>
        </div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
        {REVIEWS.map((rev) => (
          <div class="bg-surface rounded-2xl p-6 border border-deep/10 flex flex-col justify-between">
            <div>
              <div class="text-gold text-base mb-2">★★★★★</div>
              <p class="text-sm text-deep leading-relaxed">“{rev.text}”</p>
            </div>
            <div class="mt-5 pt-4 border-t border-deep/10 flex items-center justify-between gap-3 text-xs">
              <span class="font-bold text-deep">{rev.author}</span>
              <span class="text-muted">Google · {rev.date}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-deep text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-xs font-bold uppercase tracking-wider text-gold">Homeowner Engineering Library</div>
      <h2 class="font-display font-bold text-2xl sm:text-3xl uppercase mt-1">
        Technical Concrete Guides for Metro Detroit Homeowners
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
        {GUIDES.map((g) => (
          <a
            href={`/guides/${g.slug}`}
            class="bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl p-6 transition block"
          >
            <div class="text-xs font-bold uppercase text-gold">{g.category} · {g.readTime}</div>
            <h3 class="font-display font-bold text-xl uppercase mt-2">{g.title}</h3>
            <p class="text-sm text-white/75 mt-2 leading-relaxed">{g.summary}</p>
            <div class="mt-4 text-xs font-bold text-accent">Read Guide →</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQS -->
  <section class="py-16 sm:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <div class="text-xs font-bold uppercase tracking-wider text-accent">Straight Answers</div>
      <h2 class="font-display font-bold text-3xl sm:text-4xl uppercase mt-1">
        What Homeowners Ask Before the Pour
      </h2>
    </div>

    <div class="mt-10 space-y-4">
      {HOMEPAGE_FAQS.map((faq) => (
        <details class="group bg-white rounded-xl border border-deep/10 p-5 open:border-accent">
          <summary class="font-bold text-base text-deep cursor-pointer list-none flex items-center justify-between gap-4">
            <span>{faq.q}</span>
            <span class="text-accent font-bold text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="text-sm text-muted mt-3 leading-relaxed">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="bg-accent text-white py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-white/85">Spring Schedule Notice</span>
        <h2 class="font-display text-3xl sm:text-4xl font-bold uppercase mt-1">April and May Fill First</h2>
        <p class="text-base text-white/90 mt-2">
          Five inches on the driveway, six on the approach, compacted 21AA. A written contract after Matt looks at the site. Nothing is formed or poured until you approve it.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-4 shrink-0">
        <a href="/contact" class="px-6 py-4 rounded-xl bg-deep hover:bg-black text-white font-display font-bold text-base uppercase tracking-wider shadow-xl transition">
          Hold a Spring Date →
        </a>
        <a href={SITE.phoneHref} class="px-6 py-4 rounded-xl bg-white text-deep hover:bg-panel font-display font-bold text-base uppercase tracking-wider shadow-lg transition">
          Call {SITE.phone}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
