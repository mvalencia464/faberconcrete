---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateForm from '../components/EstimateForm.astro';
import { SITE, SERVICES, AREAS, GUIDES, REVIEWS, HOMEPAGE_FAQS } from '../data/site';

const counties = AREAS.filter((a) => a.type === 'county');
const cities = AREAS.filter((a) => a.type === 'city');
---

<BaseLayout
  title="Concrete Driveways in Metro Detroit | Faber Concrete"
  description="Faber Concrete pours five-inch driveways and six-inch approaches on compacted 21AA in Wayne, Oakland, Macomb, Washtenaw, and Livingston counties. Not the cheapest bid. Priced down the middle."
  faqs={HOMEPAGE_FAQS}
  howTo={true}
>
  <!-- HERO -->
  <section class="blueprint-grid text-white py-14 sm:py-20 border-b-4 border-accent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-white/10 border border-white/15 text-xs font-bold uppercase tracking-wider text-gold">
          Metro Detroit · 5 Counties · Concrete Only
        </div>
        <h1 class="font-display font-bold text-4xl sm:text-6xl uppercase tracking-tight leading-[1.05] mt-4">
          Five Inches <span class="text-accent">On Every Driveway</span>
        </h1>
        <p class="text-lg text-white/85 mt-5 leading-relaxed max-w-2xl">
          Driveways, approaches, flatwork, stamped concrete, and pavers across Metro Detroit. Never a four-inch slab. Six inches where the street meets the drive. Compacted 21AA under all of it.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-8">
          <div class="bg-white/5 border border-white/15 rounded-lg p-3.5 text-center">
            <div class="font-display font-bold text-2xl text-gold">5"</div>
            <div class="text-xs text-white/80 mt-1">Never four inches</div>
          </div>
          <div class="bg-white/5 border border-white/15 rounded-lg p-3.5 text-center">
            <div class="font-display font-bold text-2xl text-gold">6"</div>
            <div class="text-xs text-white/80 mt-1">On the approach</div>
          </div>
          <div class="bg-white/5 border border-white/15 rounded-lg p-3.5 text-center">
            <div class="font-display font-bold text-2xl text-gold">21AA</div>
            <div class="text-xs text-white/80 mt-1">Compacted base</div>
          </div>
          <div class="bg-white/5 border border-white/15 rounded-lg p-3.5 text-center">
            <div class="font-display font-bold text-2xl text-gold leading-none">25+ YRS</div>
            <div class="text-xs text-white/80 mt-1">Veteran finishers</div>
          </div>
        </div>

        <div class="mt-8 p-4 rounded-lg bg-white/5 border-l-4 border-gold text-sm text-white/90">
          <strong>Straight talk on price:</strong> “If you are looking for a cheap deal, we are not going to be it. We are going to be your best, highest quality bid, priced down the middle.” — <em>Matt Faber, Owner</em>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-4 text-xs text-white/75">
          <a href="/reviews" class="text-gold font-bold hover:underline">★★★★★ 5.0 from 5 Google Reviews</a>
          <span>·</span>
          <a href="/calculator" class="underline hover:text-white">Try the Driveway Cost Calculator →</a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <EstimateForm compact={true} />
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <div class="text-xs font-bold uppercase tracking-wider text-accent">Dedicated Concrete Services</div>
      <h2 class="font-display font-bold text-3xl sm:text-4xl uppercase mt-1">
        Driveways, Approaches, Flatwork, Stamped Concrete &amp; Pavers
      </h2>
      <p class="text-muted mt-3 leading-relaxed">
        Concrete only, in Wayne, Oakland, Macomb, Washtenaw, and Livingston counties. Homes and commercial properties. Every pour follows our five-inch / six-inch 21AA standard.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-10">
      {SERVICES.map((service) => (
        <article class="bg-white rounded-xl border border-deep/10 overflow-hidden shadow-sm hover:shadow-lg transition flex flex-col">
          <div class="relative h-56 bg-deep">
            <img
              src={service.heroImage.url}
              alt={service.heroImage.alt}
              loading="lazy"
              class="w-full h-full object-cover"
            />
            <span class="absolute bottom-2 right-2 bg-deep/85 text-white/85 text-[10px] px-2 py-0.5 rounded">
              {service.slug === 'approaches' ? 'Field photo · Not a named job' : 'AI illustration · Not a completed job photo'}
            </span>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <h3 class="font-display font-bold text-2xl uppercase">
              <a href={`/services/${service.slug}`} class="hover:text-accent transition">
                {service.title}
              </a>
            </h3>
            <p class="text-sm text-muted mt-2 leading-relaxed">{service.shortDescription}</p>
            <ul class="mt-4 space-y-1.5 text-xs font-semibold text-deep">
              {service.highlights.map((h) => (
                <li class="flex items-center gap-2">
                  <span class="text-accent font-bold">✓</span> {h}
                </li>
              ))}
            </ul>
            <div class="mt-6 pt-4 border-t border-deep/10 flex items-center justify-between">
              <a
                href={`/services/${service.slug}`}
                class="text-sm font-bold text-accent hover:text-accentHover transition"
              >
                Explore {service.title} Spec →
              </a>
              <a href="/contact" class="text-xs font-semibold text-muted hover:text-deep">
                Request Estimate
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- WHY 5 INCHES -->
  <section class="bg-panel py-16 sm:py-20 border-y border-deep/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="text-xs font-bold uppercase tracking-wider text-accent">The Slab Standard</div>
        <h2 class="font-display font-bold text-3xl sm:text-4xl uppercase mt-1">
          Why Our Slab Is Thicker (And Why Low Bids Skip It)
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-10">
        <div class="bg-white rounded-xl p-6 border border-deep/10">
          <div class="text-xs font-bold uppercase text-accent">01 · Michigan Cold</div>
          <h3 class="font-display font-bold text-xl uppercase mt-1">Freeze-Thaw &amp; 20-Ton Trucks</h3>
          <p class="text-sm text-muted mt-2 leading-relaxed">
            Freeze and thaw cycles work on a thin 4-inch slab—and so does a 20-ton delivery truck. The approach takes that hit first (6 inches), and the rest of the driveway is 5 inches.
          </p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-deep/10">
          <div class="text-xs font-bold uppercase text-accent">02 · The Cheap Inch</div>
          <h3 class="font-display font-bold text-xl uppercase mt-1">Tripping Over Dollars</h3>
          <p class="text-sm text-muted mt-2 leading-relaxed">
            Most crews pour four inches because it saves $600 to $700 on an average driveway. We charge for the fifth inch so you do not end up hating a cracked driveway early.
          </p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-deep/10">
          <div class="text-xs font-bold uppercase text-accent">03 · What Is Under It</div>
          <h3 class="font-display font-bold text-xl uppercase mt-1">Compacted 21AA, Never Sand</h3>
          <p class="text-sm text-muted mt-2 leading-relaxed">
            We never pour over dirt or uncompacted sand that erodes out from under the concrete. We grade the entire area and compact 21AA crushed limestone before forming.
          </p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-deep/10">
          <div class="text-xs font-bold uppercase text-accent">04 · Craftsmanship</div>
          <h3 class="font-display font-bold text-xl uppercase mt-1">25+ Years on the Tools</h3>
          <p class="text-sm text-muted mt-2 leading-relaxed">
            The finish is what you see every day. Our finishers have more than 25 years of experience putting clean edges and broom or stamped finishes onto full-depth slabs.
          </p>
        </div>
      </div>

      <div class="mt-10 bg-white rounded-xl p-6 border border-deep/10 flex flex-col md:flex-row items-center gap-6">
        <img
          src={SITE.methodInfographic.url}
          alt={SITE.methodInfographic.alt}
          loading="lazy"
          class="w-full md:w-80 rounded-lg border border-deep/10"
        />
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-accent">Cross-Section Standard</div>
          <h3 class="font-display font-bold text-2xl uppercase mt-1">
            Grade → Compact 21AA → 5" Driveway → 6" Approach
          </h3>
          <p class="text-sm text-muted mt-2 leading-relaxed">
            {SITE.methodInfographic.caption} Want to estimate cubic yards, 21AA tonnage, and ballpark cost for your dimensions?
          </p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href="/calculator" class="px-4 py-2 rounded bg-deep text-white font-bold text-sm hover:bg-accent transition">
              Open Driveway Cost Calculator →
            </a>
            <a href="/guides/5-inch-vs-4-inch-concrete-driveway-michigan" class="px-4 py-2 rounded border border-deep/20 text-deep font-bold text-sm hover:border-accent transition">
              Read the 5" vs. 4" Guide
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICE AREAS -->
  <section class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-7">
        <div class="text-xs font-bold uppercase tracking-wider text-accent">Metro Detroit Coverage</div>
        <h2 class="font-display font-bold text-3xl sm:text-4xl uppercase mt-1">
          5 Counties &amp; Core Communities We Serve
        </h2>
        <p class="text-muted mt-3 leading-relaxed">
          Based at 22710 Haggerty Rd. Suite 100B in Farmington Hills. We serve select ZIP codes across Wayne, Oakland, Macomb, Washtenaw, and Livingston counties aimed at homeowners who want the thicker slab. Send your address to verify your ZIP code.
        </p>

        <h3 class="font-display font-bold text-lg uppercase mt-6 text-deep">Counties Served</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-3">
          {counties.map((c) => (
            <a
              href={`/areas/${c.slug}`}
              class="p-3.5 rounded-lg bg-white border border-deep/10 hover:border-accent font-bold text-sm text-deep hover:text-accent transition"
            >
              {c.name} →
            </a>
          ))}
        </div>

        <h3 class="font-display font-bold text-lg uppercase mt-6 text-deep">Key Local Cities</h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mt-3">
          {cities.map((city) => (
            <a
              href={`/areas/${city.slug}`}
              class="px-3 py-2 rounded bg-panel hover:bg-accent hover:text-white text-xs font-semibold text-deep transition"
            >
              {city.name}
            </a>
          ))}
        </div>
      </div>

      <div class="lg:col-span-5 bg-white rounded-xl border border-deep/10 overflow-hidden shadow-sm">
        <iframe
          title="Faber Concrete Farmington Hills Location"
          src={SITE.google.embedUrl}
          class="w-full h-72 border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <div class="p-5">
          <div class="font-bold text-deep">{SITE.name}</div>
          <div class="text-sm text-muted mt-0.5">{SITE.address.formatted}</div>
          <div class="mt-3 flex items-center justify-between text-xs font-bold">
            <a href={SITE.google.directionsUrl} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
              Get Driving Directions →
            </a>
            <a href={SITE.google.profileUrl} target="_blank" rel="noopener noreferrer" class="text-deep hover:underline">
              Google Business Profile ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEWS & GUIDES -->
  <section class="bg-deep text-white py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-gold">5.0 ★ Google Rating</div>
          <h2 class="font-display font-bold text-3xl sm:text-4xl uppercase mt-1">
            Google Reviews (Published As Written)
          </h2>
        </div>
        <a href="/reviews" class="text-sm font-bold text-gold hover:underline">
          View All Reviews &amp; Disclosure →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mt-8">
        {REVIEWS.map((rev) => (
          <div class="bg-white/5 border border-white/10 rounded-xl p-5 flex flex-col justify-between">
            <div>
              <div class="text-gold text-sm">★★★★★</div>
              <p class="text-sm text-white/90 mt-3 leading-relaxed">“{rev.text}”</p>
            </div>
            <div class="mt-4 pt-3 border-t border-white/10 text-xs text-white/60">
              <strong class="text-white">{rev.author}</strong> · {rev.date} · Google
            </div>
          </div>
        ))}
      </div>

      <div class="mt-16 pt-12 border-t border-white/10">
        <div class="text-xs font-bold uppercase tracking-wider text-gold">Homeowner Engineering Library</div>
        <h3 class="font-display font-bold text-2xl sm:text-3xl uppercase mt-1">
          Technical Concrete Guides for Metro Detroit Homeowners
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
          {GUIDES.map((g) => (
            <a
              href={`/guides/${g.slug}`}
              class="bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl p-6 transition block"
            >
              <div class="text-xs font-bold uppercase text-gold">{g.category} · {g.readTime}</div>
              <h4 class="font-display font-bold text-xl uppercase mt-2">{g.title}</h4>
              <p class="text-sm text-white/75 mt-2 leading-relaxed">{g.summary}</p>
              <div class="mt-4 text-xs font-bold text-accent">Read Guide →</div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQS -->
  <section class="py-16 sm:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <div class="text-xs font-bold uppercase tracking-wider text-accent">Straight Answers</div>
      <h2 class="font-display font-bold text-3xl sm:text-4xl uppercase mt-1">
        What Homeowners Ask Before the Pour
      </h2>
    </div>

    <div class="mt-10 space-y-4">
      {HOMEPAGE_FAQS.map((faq) => (
        <details class="group bg-white rounded-xl border border-deep/10 p-5 open:border-accent">
          <summary class="font-bold text-base text-deep cursor-pointer list-none flex items-center justify-between gap-4">
            <span>{faq.q}</span>
            <span class="text-accent font-bold text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="text-sm text-muted mt-3 leading-relaxed">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
