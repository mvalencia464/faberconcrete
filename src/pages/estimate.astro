---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EstimateForm from "../components/EstimateForm.astro";
import { SITE, telHref, isPlaceholder } from "../config/site";

const phoneLink = telHref();
const title = "Request a Concrete Estimate | Faber Concrete";
const description =
  "Request an estimate from Faber Concrete. April and May book first. Five-inch slabs, six-inch approaches, compacted 21AA, priced down the middle.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Estimate</p>
        <h1>Book the spring work.</h1>
        <p class="lede">
          Tell us what you want poured. April and May are the months that get filled first — those are the jobs we like on the books before the season starts.
        </p>
        <p>
          You will not get the cheapest bid. You will get five inches, six on the approach, compacted 21AA, and a finish from people who have been doing it for more than 25 years. The price is aimed down the middle.
        </p>
        <ul class="steps">
          <li>
            <strong>Call</strong>
            {phoneLink ? <a href={phoneLink}>{SITE.phone}</a> : SITE.phone}
          </li>
          <li>
            <strong>Email</strong>
            {isPlaceholder(SITE.email) ? SITE.email : <a href={`mailto:${SITE.email}`}>{SITE.email}</a>}
          </li>
          <li>
            <strong>Where</strong>
            {SITE.city}, {SITE.state}
          </li>
        </ul>
      </div>
      <EstimateForm />
    </div>
  </main>
  <Footer />
</BaseLayout>
