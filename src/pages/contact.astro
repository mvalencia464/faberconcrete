---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroLeadForm from '../components/HeroLeadForm.astro';
import { SITE } from '../config/site';

const telHref = SITE.callHref;
---

<BaseLayout
  title={SITE.contactTitle}
  description={SITE.contactDescription}
>
  <Header />
  <main>
    <section id="quote" class="section contact-page">
      <div class="container contact-page__inner">
        <div>
          <p class="section-label">Contact</p>
          <h1>{SITE.contactHeading}</h1>
          <p>{SITE.contactIntro}</p>
          <p>
            <a class="btn btn--primary" href={telHref}>{SITE.callLabel}</a>
          </p>
          <ul class="contact-page__facts">
            <li>Site look before a price</li>
            <li>{SITE.address}</li>
            <li>{SITE.city}, {SITE.state} {SITE.zip}</li>
            <li>Residential and commercial</li>
            {SITE.email.includes("@") ? <li>{SITE.email}</li> : null}
          </ul>
        </div>
        <HeroLeadForm />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .contact-page {
    background: var(--surface);
    padding-top: 6rem;
  }

  .contact-page__inner {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .contact-page__inner {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }
  }

  .contact-page h1 {
    margin-bottom: 0.75rem;
  }

  .contact-page__facts {
    list-style: none;
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--muted);
  }
</style>
