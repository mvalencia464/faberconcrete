---
import BaseLayout from '../layouts/BaseLayout.astro';
import EstimateForm from '../components/EstimateForm.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Request a Concrete Estimate | Faber Concrete"
  description="Request an estimate for a 5-inch driveway, 6-inch approach, flatwork, stamped concrete, or pavers in Metro Detroit. Call (810) 360-7385."
  breadcrumbs={[
    { name: 'Home', url: SITE.url },
    { name: 'Contact', url: `${SITE.url}/contact` }
  ]}
>
  <section class="bg-deep text-white py-14 border-b-4 border-accent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-xs font-bold uppercase tracking-wider text-gold">Site Look First · Written Contract</div>
      <h1 class="font-display font-bold text-4xl sm:text-5xl uppercase mt-2">
        Request a Concrete Estimate
      </h1>
      <p class="text-lg text-white/85 mt-4 max-w-3xl leading-relaxed">
        Call (810) 360-7385 or send the form with your address. Matt looks at the site before pricing it and writes a contract, not just a verbal number. April and May fill first on the spring calendar.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 grid grid-cols-1 lg:grid-cols-12 gap-12">
    <div class="lg:col-span-7">
      <EstimateForm />
    </div>

    <div class="lg:col-span-5 space-y-6">
      <div class="bg-white rounded-xl p-6 border border-deep/10">
        <h2 class="font-display font-bold text-2xl uppercase">Direct Contact &amp; Shop Location</h2>
        <div class="mt-4 space-y-3 text-sm">
          <div>
            <div class="text-xs font-bold uppercase text-muted">Phone</div>
            <a href={SITE.phoneHref} class="text-xl font-bold text-accent hover:underline">{SITE.phone}</a>
          </div>
          <div>
            <div class="text-xs font-bold uppercase text-muted">Address</div>
            <div class="font-semibold text-deep">{SITE.address.formatted}</div>
          </div>
          <div>
            <div class="text-xs font-bold uppercase text-muted">Service Counties</div>
            <div class="text-muted">{SITE.region} (select ZIP codes in each county)</div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl overflow-hidden border border-deep/10">
        <iframe
          title="Faber Concrete Map"
          src={SITE.google.embedUrl}
          class="w-full h-72 border-0"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
