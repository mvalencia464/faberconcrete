---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { JOBS, getJob } from '../../data/jobs';
import { r2img } from '../../lib/r2';

export function getStaticPaths() {
  return JOBS.map((job) => ({
    params: { slug: job.slug },
  }));
}

const job = getJob(Astro.params.slug ?? '');
if (!job) {
  throw new Error(`Unknown job: ${Astro.params.slug}`);
}

const pageTitle = `${job.serviceLabel} in ${job.city} | Faber Concrete`;
const pageDescription = job.caption;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <article class="max-w-3xl mx-auto px-4 py-12">
    <p class="text-xs font-bold uppercase tracking-wider text-accent">{job.city} · {job.serviceLabel}</p>
    <h1 class="font-display font-bold text-4xl uppercase mt-2">{job.title}</h1>
    <p class="mt-4 text-muted">{job.caption}</p>
    <img src={r2img(job.cover)} alt={job.imageAlts?.[job.cover] ?? job.title} class="mt-6 w-full rounded-xl" />
    <p class="mt-2 text-xs text-muted">AI-generated illustration. This is not a photo of a completed Faber Concrete job.</p>
    <p class="mt-6">{job.summary}</p>
    <p class="mt-4 text-sm text-muted">{job.analysis.workPerformed}</p>
    <a href="/contact" class="inline-block mt-8 px-5 py-3 rounded bg-accent hover:bg-accentHover text-white font-bold">
      Request an estimate
    </a>
  </article>
</BaseLayout>
