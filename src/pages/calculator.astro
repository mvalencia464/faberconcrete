---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Metro Detroit Concrete Driveway Cost & 21AA Calculator | Faber Concrete"
  description="Calculate square footage, cubic yards of 5-inch concrete, 6-inch approach volume, tons of compacted 21AA limestone, and ballpark cost in Metro Detroit."
  breadcrumbs={[
    { name: 'Home', url: SITE.url },
    { name: 'Cost Calculator', url: `${SITE.url}/calculator` }
  ]}
>
  <section class="bg-deep text-white py-14 border-b-4 border-accent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-xs font-bold uppercase tracking-wider text-gold">Interactive Homeowner Planning Tool</div>
      <h1 class="font-display font-bold text-4xl sm:text-5xl uppercase mt-2">
        Driveway &amp; Approach Cost &amp; Material Calculator
      </h1>
      <p class="text-lg text-white/85 mt-4 max-w-3xl leading-relaxed">
        See the exact material difference between a standard 4-inch builder bid and Faber Concrete’s 5-inch driveway + 6-inch approach specification on compacted 21AA crushed limestone.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 grid grid-cols-1 lg:grid-cols-12 gap-10">
    <div class="lg:col-span-6 bg-white rounded-xl border border-deep/10 p-6 sm:p-8 shadow-sm space-y-6">
      <h2 class="font-display font-bold text-2xl uppercase">1. Enter Your Project Dimensions</h2>

      <div>
        <div class="flex justify-between text-sm font-bold">
          <label for="driveWidth">Main Driveway Width (ft)</label>
          <span id="driveWidthVal" class="text-accent">20 ft</span>
        </div>
        <input id="driveWidth" type="range" min="10" max="40" value="20" class="w-full accent-accent mt-2" />
      </div>

      <div>
        <div class="flex justify-between text-sm font-bold">
          <label for="driveLength">Main Driveway Length (ft)</label>
          <span id="driveLengthVal" class="text-accent">35 ft</span>
        </div>
        <input id="driveLength" type="range" min="15" max="120" value="35" class="w-full accent-accent mt-2" />
      </div>

      <div class="pt-4 border-t border-deep/10">
        <div class="flex justify-between text-sm font-bold">
          <label for="approachSqFt">Street Approach Area (sq ft @ 6" thick)</label>
          <span id="approachSqFtVal" class="text-accent">160 sq ft</span>
        </div>
        <input id="approachSqFt" type="range" min="0" max="450" step="10" value="160" class="w-full accent-accent mt-2" />
      </div>

      <div>
        <label for="finishType" class="block text-sm font-bold mb-1">Surface Finish</label>
        <select id="finishType" class="w-full rounded-lg border border-deep/20 px-3.5 py-2.5 text-sm bg-white">
          <option value="broom">Classic Broom Finish (5" Drive / 6" Approach)</option>
          <option value="stamped">Stamped &amp; Colored Concrete (5" Drive / 6" Approach)</option>
        </select>
      </div>

      <label class="flex items-center gap-2.5 text-sm font-semibold">
        <input id="tearOut" type="checkbox" checked class="rounded border-deep/30 text-accent" />
        <span>Include tear-out &amp; haul-away of existing failed slab</span>
      </label>
    </div>

    <div class="lg:col-span-6 bg-deep text-white rounded-xl p-6 sm:p-8 shadow-xl flex flex-col justify-between">
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-gold">Faber Concrete Spec Breakdown</div>
        <h2 class="font-display font-bold text-3xl uppercase mt-1">Estimated Materials &amp; Investment</h2>

        <div class="grid grid-cols-2 gap-4 mt-6">
          <div class="bg-white/5 border border-white/10 rounded-lg p-4">
            <div class="text-xs text-white/70">Total Concrete Area</div>
            <div id="outSqFt" class="font-display font-bold text-2xl text-gold mt-1">860 sq ft</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-lg p-4">
            <div class="text-xs text-white/70">Ready-Mix Concrete (5" + 6")</div>
            <div id="outYards" class="font-display font-bold text-2xl text-gold mt-1">13.8 cu yds</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-lg p-4">
            <div class="text-xs text-white/70">Compacted 21AA Stone Base</div>
            <div id="outStone" class="font-display font-bold text-2xl text-gold mt-1">16.1 tons</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-lg p-4">
            <div class="text-xs text-white/70">Extra Concrete vs. 4" Bid</div>
            <div id="outExtra" class="font-display font-bold text-2xl text-accent mt-1">+3.2 cu yds</div>
          </div>
        </div>

        <div class="mt-6 p-5 rounded-xl bg-white/10 border border-gold/40">
          <div class="text-xs uppercase font-bold text-gold">Ballpark Installed Range (Priced Down the Middle)</div>
          <div id="outPrice" class="font-display font-bold text-3xl sm:text-4xl mt-1">$11,180 – $13,330</div>
          <p class="text-xs text-white/75 mt-2 leading-relaxed">
            Includes full-area grading, compacted 21AA base, 5-inch driveway pour, 6-inch street approach, and 25+ year finishing. Final price is confirmed in a written contract after Matt Faber inspects your site.
          </p>
        </div>
      </div>

      <div class="mt-8">
        <a
          href="/contact"
          class="block text-center w-full py-3.5 px-6 rounded-lg bg-accent hover:bg-accentHover text-white font-bold text-base transition"
        >
          Lock In an On-Site Inspection &amp; Written Spec →
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    function recalc() {
      const w = Number(document.getElementById('driveWidth').value);
      const l = Number(document.getElementById('driveLength').value);
      const app = Number(document.getElementById('approachSqFt').value);
      const finish = document.getElementById('finishType').value;
      const tearOut = document.getElementById('tearOut').checked;

      document.getElementById('driveWidthVal').textContent = w + ' ft';
      document.getElementById('driveLengthVal').textContent = l + ' ft';
      document.getElementById('approachSqFtVal').textContent = app + ' sq ft';

      const driveSqFt = w * l;
      const totalSqFt = driveSqFt + app;

      const faberYards = ((driveSqFt * (5 / 12)) + (app * (6 / 12))) / 27;
      const cheapYards = (totalSqFt * (4 / 12)) / 27;
      const extraYards = Math.max(0, faberYards - cheapYards);
      const tons21AA = (totalSqFt * (4 / 12) / 27) * 1.5;

      let lowRate = finish === 'stamped' ? 17.5 : 11.5;
      let highRate = finish === 'stamped' ? 22.0 : 14.0;
      if (tearOut) {
        lowRate += 2.0;
        highRate += 2.5;
      }

      const lowTotal = Math.round(totalSqFt * lowRate);
      const highTotal = Math.round(totalSqFt * highRate);

      document.getElementById('outSqFt').textContent = totalSqFt.toLocaleString() + ' sq ft';
      document.getElementById('outYards').textContent = faberYards.toFixed(1) + ' cu yds';
      document.getElementById('outStone').textContent = tons21AA.toFixed(1) + ' tons';
      document.getElementById('outExtra').textContent = '+' + extraYards.toFixed(1) + ' cu yds';
      document.getElementById('outPrice').textContent =
        '$' + lowTotal.toLocaleString() + ' – $' + highTotal.toLocaleString();
    }

    ['driveWidth', 'driveLength', 'approachSqFt', 'finishType', 'tearOut'].forEach((id) => {
      document.getElementById(id).addEventListener('input', recalc);
      document.getElementById(id).addEventListener('change', recalc);
    });
    recalc();
  </script>
</BaseLayout>
