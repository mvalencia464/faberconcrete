---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Picture from "../components/Picture.astro";
import { gallery } from "../data/gallery";

const title = "Concrete Job Gallery | Faber Concrete";
const description =
  "Photos of Faber Concrete driveways, approaches, and flatwork. New job photos are added from the field upload link.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="section">
    <div class="wrap">
      <p class="eyebrow">Gallery</p>
      <h1>Jobs, when the photos are in.</h1>
      <p class="lede">
        Field photos and video are uploaded from the phone, then published here as AVIF and WebP from media.stokeleads.com. Nothing is shown until a real job photo is in the list.
      </p>
      {
        gallery.length === 0 ? (
          <div class="empty">
            <p>
              No job photos yet. Add an AVIF and WebP pair to <code>src/data/gallery.ts</code>. The picture component is already built for that pair.
            </p>
            <p>
              Upload from the field at <a href="/photos">/photos</a> once the Stoke Leads token is set.
            </p>
          </div>
        ) : (
          <div class="gallery-grid">
            {gallery.map((photo) => (
              <figure>
                <Picture
                  avif={photo.avif}
                  webp={photo.webp}
                  alt={photo.alt}
                  width={photo.width}
                  height={photo.height}
                  sizes="(min-width: 720px) 50vw, 100vw"
                />
                {photo.caption && <figcaption>{photo.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )
      }
    </div>
  </main>
  <Footer />
</BaseLayout>
