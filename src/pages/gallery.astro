---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Picture from "../components/Picture.astro";
import { gallery } from "../data/gallery";
import { aiNote, crew, newConstruction, patterns, scenes } from "../data/media";

const title = "Concrete Patterns and Driveway Photos | Faber Concrete";
const description =
  "Stamped concrete pattern illustrations and driveway scenes from Faber Concrete. Generated images are labeled as illustrations, not photos of a completed job.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="section">
    <div class="wrap">
      <p class="eyebrow">Gallery</p>
      <h1>Patterns, then the driveway.</h1>
      <p class="lede">
        The pattern close-ups and most of the driveway scenes are illustrations. Each one that is generated says so in the caption. A real job photo is a separate list and is not mixed in with these.
      </p>

      <h2 id="patterns">Stamped patterns</h2>
      <p>{aiNote}</p>
      <div class="pattern-grid">
        {
          patterns.map((photo) => (
            <figure class="frame">
              <Picture
                avif={photo.avif}
                webp={photo.webp}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                sizes="(min-width: 900px) 20vw, 50vw"
              />
              <figcaption>{photo.label}</figcaption>
            </figure>
          ))
        }
      </div>

      <h2>Driveway scenes</h2>
      <div class="gallery-grid">
        {
          scenes.map((photo) => (
            <figure
              class:list={[
                "frame",
                photo.avif === crew.avif && "frame--cover",
                photo.avif === newConstruction.avif && "frame--approach",
              ]}
            >
              <Picture
                avif={photo.avif}
                webp={photo.webp}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                sizes="(min-width: 720px) 50vw, 100vw"
              />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))
        }
      </div>

      <h2>Completed jobs</h2>
      {
        gallery.length === 0 ? (
          <div class="empty">
            <p>
              No completed-job photos yet. Those get added to <code>src/data/gallery.ts</code> after a real upload, as an AVIF and WebP pair. They are not the illustrations above.
            </p>
            <p>
              Upload from the field at <a href="/photos">/photos</a> once the Stoke Leads token is set.
            </p>
          </div>
        ) : (
          <div class="gallery-grid">
            {gallery.map((photo) => (
              <figure class="frame">
                <Picture
                  avif={photo.avif}
                  webp={photo.webp}
                  alt={photo.alt}
                  width={photo.width}
                  height={photo.height}
                  sizes="(min-width: 720px) 50vw, 100vw"
                />
                {photo.caption && <figcaption>{photo.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )
      }
    </div>
  </main>
  <Footer />
</BaseLayout>
