---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, GUIDES } from '../../data/site';
---

<BaseLayout
  title="Homeowner Concrete Engineering & Buying Guides | Faber Concrete"
  description="Practical guides for Metro Detroit homeowners comparing 5-inch vs 4-inch driveways, 21AA crushed limestone bases, and concrete contractor contracts."
  breadcrumbs={[
    { name: 'Home', url: SITE.url },
    { name: 'Guides', url: `${SITE.url}/guides` }
  ]}
>
  <section class="bg-deep text-white py-14 border-b-4 border-accent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-xs font-bold uppercase tracking-wider text-gold">Topical Authority &amp; Homeowner Education</div>
      <h1 class="font-display font-bold text-4xl sm:text-5xl uppercase mt-2">
        Metro Detroit Homeowner Concrete Guides
      </h1>
      <p class="text-lg text-white/85 mt-4 max-w-3xl leading-relaxed">
        Straightforward technical breakdowns written to help Michigan homeowners compare concrete quotes apples-to-apples before signing a contract.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 grid grid-cols-1 md:grid-cols-3 gap-8">
    {GUIDES.map((guide) => (
      <article class="bg-white rounded-xl border border-deep/10 p-6 shadow-sm flex flex-col justify-between">
        <div>
          <div class="text-xs font-bold uppercase text-accent">{guide.category} · {guide.readTime}</div>
          <h2 class="font-display font-bold text-2xl uppercase mt-2">
            <a href={`/guides/${guide.slug}`} class="hover:text-accent transition">
              {guide.title}
            </a>
          </h2>
          <p class="text-sm text-muted mt-3 leading-relaxed">{guide.summary}</p>
        </div>
        <div class="mt-6 pt-4 border-t border-deep/10">
          <a href={`/guides/${guide.slug}`} class="text-sm font-bold text-accent hover:underline">
            Read Full Guide →
          </a>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
