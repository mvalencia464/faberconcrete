---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, REVIEWS } from '../data/site';
---

<BaseLayout
  title="Google Reviews for Faber | 5.0 Stars | Faber Concrete"
  description="Read verified Google reviews for Faber (5.0 out of 5 from 5 Google reviews), published as written."
  breadcrumbs={[
    { name: 'Home', url: SITE.url },
    { name: 'Reviews', url: `${SITE.url}/reviews` }
  ]}
>
  <section class="bg-deep text-white py-14 border-b-4 border-accent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-xs font-bold uppercase tracking-wider text-gold">5.0 Out of 5 Stars · 5 Google Reviews</div>
      <h1 class="font-display font-bold text-4xl sm:text-5xl uppercase mt-2">
        Google Reviews
      </h1>
      <p class="text-lg text-white/85 mt-4 max-w-3xl leading-relaxed">
        The words below are the review texts as published on our Google Business Profile (listed under Faber Roof while our public concrete brand operates here as Faber Concrete). One 5-star review without text is omitted.
      </p>
      <div class="mt-6">
        <a
          href={SITE.google.profileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-5 py-2.5 rounded bg-gold text-deep font-bold text-sm"
        >
          View on Google Maps ↗
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-6">
    {REVIEWS.map((rev) => (
      <div class="bg-white rounded-xl p-6 border border-deep/10 shadow-sm">
        <div class="flex items-center justify-between">
          <div class="text-gold text-base">★★★★★</div>
          <span class="text-xs text-muted">{rev.date} · Google</span>
        </div>
        <p class="text-base text-deep mt-3 leading-relaxed">“{rev.text}”</p>
        <div class="text-xs font-bold text-muted mt-3">— {rev.author}</div>
      </div>
    ))}
  </section>
</BaseLayout>
