---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EstimateForm from '../../components/EstimateForm.astro';
import { SITE, SERVICES, AREAS } from '../../data/site';

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
const otherServices = SERVICES.filter((s) => s.slug !== service.slug);
const counties = AREAS.filter((a) => a.type === 'county');

const cardMeta: Record<string, { badge: string; title: string }> = {
  driveways: { badge: '5" Slab + 21AA', title: 'Concrete Driveways' },
  approaches: { badge: '6" Street Apron', title: 'Driveway Approaches' },
  flatwork: { badge: '5" Full Depth', title: 'Concrete Flatwork' },
  patios: { badge: 'Decorative + Structural', title: 'Stamped Concrete & Pavers' }
};
const card = cardMeta[service.slug];
const badge = card?.badge ?? 'Faber Concrete Spec';
const pageTitle = card?.title ?? service.title;
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  faqs={service.faqs}
  serviceName={service.title}
  breadcrumbs={[
    { name: 'Home', url: SITE.url },
    { name: 'Services', url: `${SITE.url}/#services` },
    { name: service.title, url: `${SITE.url}/services/${service.slug}` }
  ]}
>
  <section class="py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs font-semibold text-muted mb-6">
        <a href="/" class="hover:text-accent">Home</a>
        <span>/</span>
        <a href="/#services" class="hover:text-accent">Services</a>
        <span>/</span>
        <span class="text-deep font-bold">{service.title}</span>
      </nav>

      <div class="bg-deep text-white rounded-3xl overflow-hidden shadow-xl mb-12">
        <div class="grid lg:grid-cols-12">
          <div class="lg:col-span-7 p-8 sm:p-12 flex flex-col justify-center space-y-5">
            <span class="inline-block w-fit px-3 py-1 rounded-full bg-accent text-white text-xs font-bold uppercase tracking-wider">
              {badge}
            </span>
            <h1 class="font-display text-3xl sm:text-5xl font-bold uppercase leading-tight">
              {pageTitle} in Farmington Hills &amp; Metro Detroit
            </h1>
            <p class="text-base text-white/85 leading-relaxed">{service.shortDescription}</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
              {service.highlights.map((h) => (
                <div class="bg-white/10 border border-white/15 rounded-xl px-3.5 py-2 text-xs font-bold text-gold">✓ {h}</div>
              ))}
            </div>
            <div class="pt-3 flex flex-wrap gap-3">
              <a href="/contact" class="px-6 py-3.5 rounded-xl bg-accent hover:bg-accentHover text-white font-display font-bold uppercase tracking-wider text-sm shadow-lg transition">
                Request Site Estimate →
              </a>
              <a href={SITE.phoneHref} class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-display font-bold uppercase tracking-wider text-sm border border-white/20 transition">
                Call {SITE.phone}
              </a>
            </div>
          </div>
          <div class="lg:col-span-5 relative min-h-[280px] bg-black/40">
            <img src={service.heroImage.url} alt={service.heroImage.alt} class="absolute inset-0 w-full h-full object-cover" />
            <div class="absolute bottom-3 left-3 right-3 bg-deep/90 text-white/80 text-[11px] px-3 py-2 rounded-lg border border-white/10">
              {service.heroImage.alt}
            </div>
          </div>
        </div>
      </div>

      <div class="grid lg:grid-cols-12 gap-10">
        <div class="lg:col-span-8 space-y-8">
          <p class="text-base text-deep/85 leading-relaxed">{service.fullDescription}</p>

          <div class="space-y-6">
            {service.sections.map((sec) => (
              <div class="bg-white rounded-2xl p-6 sm:p-8 border border-deep/10 shadow-sm">
                <h2 class="font-display text-2xl font-bold uppercase text-deep mb-3">{sec.heading}</h2>
                <p class="text-sm sm:text-base text-deep/85 leading-relaxed">{sec.body}</p>
              </div>
            ))}
          </div>

          <div id="slab" class="bg-white rounded-2xl p-6 border border-deep/10 shadow-sm">
            <h2 class="font-display text-2xl font-bold uppercase text-deep mb-3">How the Slab Goes In</h2>
            <img
              src={SITE.methodInfographic.url}
              alt={SITE.methodInfographic.alt}
              loading="lazy"
              class="w-full rounded-xl border border-deep/10 mb-3"
            />
            <p class="text-xs text-muted">{SITE.methodInfographic.caption}</p>
          </div>

          {service.gallery.length > 0 && (
            <div class="bg-white rounded-2xl p-6 border border-deep/10 shadow-sm">
              <h2 class="font-display text-2xl font-bold uppercase text-deep mb-1">Reference Illustrations &amp; Patterns</h2>
              <p class="text-xs text-muted mb-4">AI illustrations showing crew workflow, edge finishing, and stamped color profiles. Not photos of a named Faber Concrete job.</p>
              <div class="grid sm:grid-cols-2 gap-4">
                {service.gallery.map((img) => (
                  <figure class="rounded-xl overflow-hidden border border-deep/10 bg-surface">
                    <img src={img.url} alt={img.alt} loading="lazy" class="w-full h-48 object-cover" />
                    <figcaption class="p-3 text-xs text-muted">{img.alt}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          )}

          <div class="bg-white rounded-2xl p-6 border border-deep/10 shadow-sm">
            <h2 class="font-display text-2xl font-bold uppercase text-deep mb-2">Areas We Serve</h2>
            <p class="text-sm text-muted">
              Faber Concrete serves select ZIP codes across all five Metro Detroit counties. Send your address to confirm coverage.
            </p>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-4">
              {counties.map((c) => (
                <a
                  href={`/areas/${c.slug}`}
                  class="flex items-center justify-between p-3.5 rounded-xl bg-surface border border-deep/10 hover:border-accent text-left shadow-sm transition"
                >
                  <span class="font-display font-bold uppercase text-deep text-sm">{c.name}</span>
                  <span class="text-accent font-bold">→</span>
                </a>
              ))}
            </div>
          </div>

          <div class="bg-panel rounded-2xl p-6 sm:p-8 border border-deep/10">
            <h2 class="font-display text-2xl font-bold uppercase text-deep mb-4">Common Questions</h2>
            <div class="space-y-4">
              {service.faqs.map((faq) => (
                <div class="bg-white rounded-xl p-4 border border-deep/10">
                  <div class="font-bold text-sm text-deep">{faq.q}</div>
                  <p class="text-xs sm:text-sm text-muted mt-1.5 leading-relaxed">{faq.a}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <aside class="lg:col-span-4 space-y-6">
          <div class="bg-white rounded-2xl p-6 border border-deep/10 shadow-lg">
              <span class="text-xs font-bold uppercase tracking-wider text-accent">Written Contract · No Curb Guessing</span>
              <h2 class="font-display text-2xl font-bold uppercase text-deep mt-1">Request an Estimate</h2>
              <p class="text-sm text-muted mt-2 leading-relaxed">
                Call <a href={SITE.phoneHref} class="font-bold text-deep underline">{SITE.phone}</a> or send the address. Matt Faber looks at the site, then writes the estimate and the contract. April and May fill first.
              </p>
              <div class="mt-5 space-y-2.5 text-xs font-semibold text-deep bg-surface p-4 rounded-xl border border-deep/10">
                <div>✓ Five inches on every driveway</div>
                <div>✓ Six inches where it meets the street</div>
                <div>✓ Graded &amp; compacted 21AA base</div>
                <div>✓ Finishers with 25+ years experience</div>
              </div>
              <a href="/contact" class="mt-5 w-full py-3.5 rounded-xl bg-accent hover:bg-accentHover text-white font-display font-bold uppercase tracking-wider text-sm shadow-md transition text-center block">
                Send Address for Site Look →
              </a>
              <div class="mt-6 pt-5 border-t border-deep/10">
                <div class="text-xs font-bold uppercase tracking-wider text-muted mb-3">Other Concrete Services</div>
                <div class="space-y-2">
                  {otherServices.map((other) => (
                    <a href={`/services/${other.slug}`} class="block text-sm font-semibold text-deep hover:text-accent">
                      → {other.title}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          <EstimateForm preselectedService={service.slug} />
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
