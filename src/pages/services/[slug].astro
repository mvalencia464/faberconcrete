---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EstimateForm from '../../components/EstimateForm.astro';
import { SITE, SERVICES, AREAS } from '../../data/site';

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
const otherServices = SERVICES.filter((s) => s.slug !== service.slug);
const counties = AREAS.filter((a) => a.type === 'county');
---

<BaseLayout
  title={service.seoTitle}
  description={service.seoDescription}
  faqs={service.faqs}
  serviceName={service.title}
  breadcrumbs={[
    { name: 'Home', url: SITE.url },
    { name: 'Services', url: `${SITE.url}/#services` },
    { name: service.title, url: `${SITE.url}/services/${service.slug}` }
  ]}
>
  <section class="bg-deep text-white py-14 border-b-4 border-accent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-white/60 mb-4">
        <a href="/" class="hover:text-white">Home</a> / <a href="/#services" class="hover:text-white">Services</a> / <span class="text-gold">{service.title}</span>
      </nav>
      <h1 class="font-display font-bold text-4xl sm:text-5xl uppercase tracking-tight">
        {service.title} in Farmington Hills &amp; Metro Detroit
      </h1>
      <p class="text-lg text-white/85 mt-4 max-w-3xl leading-relaxed">{service.fullDescription}</p>
      <div class="flex flex-wrap gap-2.5 mt-6">
        {service.highlights.map((h) => (
          <span class="px-3 py-1.5 rounded bg-white/10 border border-white/15 text-xs font-bold text-gold">
            ✓ {h}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 grid grid-cols-1 lg:grid-cols-12 gap-12">
    <div class="lg:col-span-7 space-y-10">
      <div class="relative rounded-xl overflow-hidden border border-deep/10 bg-deep">
        <img src={service.heroImage.url} alt={service.heroImage.alt} class="w-full h-80 object-cover" />
        <div class="p-3 bg-deep text-white/75 text-xs">{service.heroImage.alt}</div>
      </div>

      {service.sections.map((sec) => (
        <div>
          <h2 class="font-display font-bold text-2xl sm:text-3xl uppercase text-deep">{sec.heading}</h2>
          <p class="text-muted mt-3 leading-relaxed">{sec.body}</p>
        </div>
      ))}

      <div id="slab" class="bg-panel rounded-xl p-6 border border-deep/10">
        <h2 class="font-display font-bold text-2xl uppercase">How the Slab Goes In</h2>
        <img
          src={SITE.methodInfographic.url}
          alt={SITE.methodInfographic.alt}
          loading="lazy"
          class="w-full rounded-lg mt-4 border border-deep/10"
        />
        <p class="text-xs text-muted mt-2">{SITE.methodInfographic.caption}</p>
      </div>

      {service.gallery.length > 0 && (
        <div>
          <h2 class="font-display font-bold text-2xl uppercase">Illustrations &amp; Pattern Samples</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
            {service.gallery.map((img) => (
              <figure class="bg-white rounded-lg overflow-hidden border border-deep/10">
                <img src={img.url} alt={img.alt} loading="lazy" class="w-full h-48 object-cover" />
                <figcaption class="p-2.5 text-[11px] text-muted">{img.alt}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      )}

      <div>
        <h2 class="font-display font-bold text-2xl uppercase">Areas We Serve</h2>
        <p class="text-sm text-muted mt-2">
          Faber Concrete serves select ZIP codes across all five Metro Detroit counties. Send your address to confirm coverage:
        </p>
        <div class="flex flex-wrap gap-2 mt-4">
          {counties.map((c) => (
            <a
              href={`/areas/${c.slug}`}
              class="px-3.5 py-2 rounded bg-white border border-deep/10 hover:border-accent text-xs font-bold text-deep"
            >
              {c.name} →
            </a>
          ))}
        </div>
      </div>

      <div>
        <h2 class="font-display font-bold text-2xl uppercase">Frequently Asked Questions</h2>
        <div class="space-y-3 mt-4">
          {service.faqs.map((faq) => (
            <details class="bg-white rounded-lg border border-deep/10 p-4">
              <summary class="font-bold text-sm cursor-pointer">{faq.q}</summary>
              <p class="text-sm text-muted mt-2 leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>

    <aside class="lg:col-span-5 space-y-8">
      <div class="sticky top-24 space-y-6">
        <EstimateForm preselectedService={service.slug} />

        <div class="bg-white rounded-xl p-6 border border-deep/10">
          <h3 class="font-display font-bold text-lg uppercase">Other Concrete Services</h3>
          <div class="mt-3 space-y-2.5">
            {otherServices.map((other) => (
              <a
                href={`/services/${other.slug}`}
                class="block p-3 rounded-lg bg-surface hover:bg-panel transition"
              >
                <div class="font-bold text-sm text-deep">{other.title} →</div>
                <div class="text-xs text-muted line-clamp-1">{other.shortDescription}</div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </aside>
  </section>
</BaseLayout>
