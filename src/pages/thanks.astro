---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Request Received | Faber Concrete"
  description="We received your concrete estimate request and will be in touch soon."
  noindex={true}
>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-20 text-center">
    <div class="w-16 h-16 rounded-full bg-accent/15 text-accent text-3xl flex items-center justify-center mx-auto font-bold">
      ✓
    </div>
    <h1 class="font-display font-bold text-4xl uppercase mt-6">Request Received!</h1>
    <p class="text-base text-muted mt-4 leading-relaxed">
      Thanks for contacting Faber Concrete. Matt Faber will review your address and follow up directly about a look at the site and an estimate.
    </p>
    <p class="text-sm text-muted mt-2">
      If you left your street address out, please resubmit or call <a href={SITE.phoneHref} class="font-bold text-deep underline">{SITE.phone}</a>.
    </p>
    <div class="mt-8">
      <a href="/" class="inline-block px-6 py-3 rounded-lg bg-deep text-white font-bold text-sm">
        ← Back to Homepage
      </a>
    </div>
  </section>
</BaseLayout>
