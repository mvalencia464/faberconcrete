---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Page not found | Faber Concrete" description="That page is not on the Faber Concrete site.">
  <Header />
  <main class="section">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That page is not here.</h1>
      <p><a class="btn btn--tide" href="/">Back to the homepage</a></p>
    </div>
  </main>
  <Footer />
</BaseLayout>
