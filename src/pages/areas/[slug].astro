---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EstimateForm from '../../components/EstimateForm.astro';
import { SITE, SERVICES, AREAS } from '../../data/site';

export function getStaticPaths() {
  return AREAS.map((area) => ({
    params: { slug: area.slug },
    props: { area }
  }));
}

const { area } = Astro.props;
const nearbyAreas = AREAS.filter((a) => a.slug !== area.slug).slice(0, 6);
---

<BaseLayout
  title={area.seoTitle}
  description={area.seoDescription}
  faqs={area.faqs}
  breadcrumbs={[
    { name: 'Home', url: SITE.url },
    { name: 'Service Areas', url: `${SITE.url}/areas` },
    { name: area.name, url: `${SITE.url}/areas/${area.slug}` }
  ]}
>
  <section class="bg-deep text-white py-14 border-b-4 border-accent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs text-white/60 mb-4">
        <a href="/" class="hover:text-white">Home</a> / <a href="/areas" class="hover:text-white">Service Areas</a> / <span class="text-gold">{area.name}</span>
      </nav>
      <h1 class="font-display font-bold text-4xl sm:text-5xl uppercase tracking-tight">
        {area.headline}
      </h1>
      <p class="text-lg text-white/85 mt-4 max-w-3xl leading-relaxed">{area.intro}</p>
      <div class="flex flex-wrap gap-2.5 mt-6">
        {area.highlights.map((h) => (
          <span class="px-3 py-1.5 rounded bg-white/10 border border-white/15 text-xs font-bold text-gold">
            ✓ {h}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 grid grid-cols-1 lg:grid-cols-12 gap-12">
    <div class="lg:col-span-7 space-y-8">
      <div class="bg-white rounded-xl p-6 border border-deep/10">
        <div class="text-xs font-bold uppercase text-accent">Local Subgrade &amp; Freeze-Thaw</div>
        <h2 class="font-display font-bold text-2xl uppercase mt-1">
          Soil Conditions &amp; Slab Engineering in {area.name}
        </h2>
        <p class="text-sm text-muted mt-3 leading-relaxed">{area.soilAndClimate}</p>
      </div>

      <div class="bg-white rounded-xl p-6 border border-deep/10">
        <div class="text-xs font-bold uppercase text-accent">Permits &amp; Right-of-Way Aprons</div>
        <h2 class="font-display font-bold text-2xl uppercase mt-1">
          Municipal Approach Standards in {area.name}
        </h2>
        <p class="text-sm text-muted mt-3 leading-relaxed">{area.localCodes}</p>
      </div>

      <div class="bg-panel rounded-xl p-6 border border-deep/10">
        <div class="text-xs font-bold uppercase text-accent">Shop Dispatch &amp; Directions</div>
        <h2 class="font-display font-bold text-2xl uppercase mt-1">
          Dispatched From Our Farmington Hills Headquarters
        </h2>
        <p class="text-sm text-muted mt-2 leading-relaxed">{area.dispatchRoute}</p>
        <div class="mt-4 rounded-lg overflow-hidden border border-deep/10">
          <iframe
            title={`Faber Concrete Map for ${area.name}`}
            src={SITE.google.embedUrl}
            class="w-full h-60 border-0"
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <div>
        <h2 class="font-display font-bold text-2xl uppercase">Services Available in {area.name}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
          {SERVICES.map((s) => (
            <a
              href={`/services/${s.slug}`}
              class="p-4 rounded-xl bg-white border border-deep/10 hover:border-accent transition block"
            >
              <div class="font-bold text-deep">{s.title} in {area.name} →</div>
              <p class="text-xs text-muted mt-1">{s.shortDescription}</p>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h2 class="font-display font-bold text-2xl uppercase">{area.name} Concrete FAQs</h2>
        <div class="space-y-3 mt-4">
          {area.faqs.map((faq) => (
            <details class="bg-white rounded-lg border border-deep/10 p-4">
              <summary class="font-bold text-sm cursor-pointer">{faq.q}</summary>
              <p class="text-sm text-muted mt-2 leading-relaxed">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>

      <div>
        <h3 class="font-display font-bold text-xl uppercase">Nearby Metro Detroit Service Areas</h3>
        <div class="flex flex-wrap gap-2 mt-3">
          {nearbyAreas.map((nb) => (
            <a
              href={`/areas/${nb.slug}`}
              class="px-3 py-1.5 rounded bg-white border border-deep/10 hover:border-accent text-xs font-semibold"
            >
              {nb.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <aside class="lg:col-span-5">
      <div class="sticky top-24">
        <EstimateForm />
      </div>
    </aside>
  </section>
</BaseLayout>
