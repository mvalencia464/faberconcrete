---
import { SITE, SERVICES } from '../data/site';

interface Props {
  compact?: boolean;
  preselectedService?: string;
}

const { compact = false, preselectedService = '' } = Astro.props;
---

<form
  action="/api/lead"
  method="POST"
  class="bg-white rounded-xl border border-deep/10 shadow-xl p-6 sm:p-8 text-deep"
>
  <input type="hidden" name="form-name" value="estimate" />
  <input type="text" name="website" value="" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  <div class="text-xs font-bold uppercase tracking-wider text-accent">Site Look First · Written Contract</div>
  <h2 class="font-display font-bold text-2xl sm:text-3xl uppercase mt-1">
    Get a Concrete Estimate
  </h2>
  <p class="text-sm text-muted mt-1">
    Share your address. Matt Faber checks ZIP coverage, walks the site, and writes the estimate.
  </p>

  <div class={`grid grid-cols-1 ${compact ? 'sm:grid-cols-2' : 'sm:grid-cols-2'} gap-4 mt-5`}>
    <div>
      <label class="block text-xs font-bold uppercase tracking-wider text-deep mb-1">First Name *</label>
      <input
        type="text"
        name="first_name"
        required
        placeholder="Matt"
        class="w-full rounded-lg border border-deep/20 px-3.5 py-2.5 text-sm focus:border-accent focus:outline-none"
      />
    </div>
    <div>
      <label class="block text-xs font-bold uppercase tracking-wider text-deep mb-1">Last Name *</label>
      <input
        type="text"
        name="last_name"
        required
        placeholder="Homeowner"
        class="w-full rounded-lg border border-deep/20 px-3.5 py-2.5 text-sm focus:border-accent focus:outline-none"
      />
    </div>
    <div>
      <label class="block text-xs font-bold uppercase tracking-wider text-deep mb-1">Phone *</label>
      <input
        type="tel"
        name="phone"
        required
        placeholder="(248) 555-0199"
        class="w-full rounded-lg border border-deep/20 px-3.5 py-2.5 text-sm focus:border-accent focus:outline-none"
      />
    </div>
    <div>
      <label class="block text-xs font-bold uppercase tracking-wider text-deep mb-1">Email (Optional)</label>
      <input
        type="email"
        name="email"
        placeholder="you@example.com"
        class="w-full rounded-lg border border-deep/20 px-3.5 py-2.5 text-sm focus:border-accent focus:outline-none"
      />
    </div>
    <div class="sm:col-span-2">
      <label class="block text-xs font-bold uppercase tracking-wider text-deep mb-1">Project Street Address &amp; ZIP *</label>
      <input
        type="text"
        name="address"
        required
        placeholder="12345 Example Rd, Farmington Hills, MI 48335"
        class="w-full rounded-lg border border-deep/20 px-3.5 py-2.5 text-sm focus:border-accent focus:outline-none"
      />
    </div>
    <div>
      <label class="block text-xs font-bold uppercase tracking-wider text-deep mb-1">Service Needed *</label>
      <select
        name="project_type"
        required
        class="w-full rounded-lg border border-deep/20 px-3.5 py-2.5 text-sm bg-white focus:border-accent focus:outline-none"
      >
        <option value="">Select a concrete service</option>
        {SERVICES.map((s) => (
          <option value={s.slug} selected={preselectedService === s.slug}>
            {s.title}
          </option>
        ))}
        <option value="other">Something else</option>
      </select>
    </div>
    <div>
      <label class="block text-xs font-bold uppercase tracking-wider text-deep mb-1">Target Timeline</label>
      <select
        name="timeline"
        class="w-full rounded-lg border border-deep/20 px-3.5 py-2.5 text-sm bg-white focus:border-accent focus:outline-none"
      >
        <option value="spring">Spring (April &amp; May fill first)</option>
        <option value="summer">Summer</option>
        <option value="fall">Fall</option>
        <option value="flexible">Flexible</option>
      </select>
    </div>
    {!compact && (
      <div class="sm:col-span-2">
        <label class="block text-xs font-bold uppercase tracking-wider text-deep mb-1">Project Notes (Optional)</label>
        <textarea
          name="notes"
          rows="3"
          placeholder="Approximate width/length, tear-out needed, or approach details..."
          class="w-full rounded-lg border border-deep/20 px-3.5 py-2.5 text-sm focus:border-accent focus:outline-none"
        ></textarea>
      </div>
    )}
  </div>

  <label class="flex items-start gap-2.5 mt-4 text-xs text-muted leading-relaxed">
    <input type="checkbox" name="consent_sms" value="yes" required class="mt-0.5 rounded border-deep/30 text-accent focus:ring-accent" />
    <span>
      I agree to Faber Concrete's <a href="/terms" class="underline">Terms</a> and <a href="/policy" class="underline">Privacy Policy</a>, and consent to be contacted about my concrete estimate.
    </span>
  </label>

  <button
    type="submit"
    class="mt-5 w-full py-3.5 px-6 rounded-lg bg-accent hover:bg-accentHover text-white font-bold text-base shadow-lg transition"
  >
    Send My Estimate Request →
  </button>

  <div class="mt-3 text-center text-xs text-muted">
    No pour until you approve the written contract. Or call <a href={SITE.phoneHref} class="font-bold text-deep underline">{SITE.phone}</a>.
  </div>
</form>
