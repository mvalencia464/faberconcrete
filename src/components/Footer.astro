---
import { SITE, SERVICES, AREAS } from '../data/site';

const counties = AREAS.filter((a) => a.type === 'county');
---

<footer class="bg-deep text-white border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
    <div>
      <div class="font-display font-bold text-2xl uppercase tracking-tight">Faber Concrete</div>
      <p class="text-sm text-white/75 mt-3 leading-relaxed">
        Concrete driveways, approaches, flatwork, stamped concrete, and pavers. A separate company, priced down the middle.
      </p>
      <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded bg-white/10 text-xs font-semibold text-gold">
        ✓ Licensed &amp; Insured · Concrete Only
      </div>
      <div class="mt-4">
        <a
          href={SITE.google.profileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-gold hover:underline font-semibold"
        >
          ★ {SITE.google.rating.toFixed(1)} on Google ({SITE.google.count} Reviews) →
        </a>
      </div>
    </div>

    <div>
      <h3 class="font-display font-bold uppercase tracking-wider text-sm text-gold">Concrete Services</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-white/80">
        {SERVICES.map((s) => (
          <li>
            <a href={`/services/${s.slug}`} class="hover:text-white transition">{s.title}</a>
          </li>
        ))}
        <li>
          <a href="/calculator" class="hover:text-white transition">Driveway Cost Calculator</a>
        </li>
        <li>
          <a href="/guides" class="hover:text-white transition">Homeowner Concrete Guides</a>
        </li>
      </ul>
    </div>

    <div>
      <h3 class="font-display font-bold uppercase tracking-wider text-sm text-gold">Service Areas</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-white/80">
        {counties.map((c) => (
          <li>
            <a href={`/areas/${c.slug}`} class="hover:text-white transition">{c.name}</a>
          </li>
        ))}
        <li>
          <a href="/areas" class="text-gold hover:underline font-semibold">View All Counties &amp; Cities →</a>
        </li>
      </ul>
    </div>

    <div>
      <h3 class="font-display font-bold uppercase tracking-wider text-sm text-gold">Contact &amp; Shop NAP</h3>
      <address class="not-italic mt-4 space-y-2.5 text-sm text-white/85">
        <div class="font-bold text-white">{SITE.name}</div>
        <div>{SITE.address.formatted}</div>
        <div>
          <a href={SITE.phoneHref} class="text-gold font-bold text-base hover:underline">
            {SITE.phone}
          </a>
        </div>
        <div class="text-white/60 text-xs">Hours: Call for hours · Site look first</div>
      </address>
      <div class="mt-4 flex flex-wrap gap-3 text-xs">
        <a
          href={SITE.google.directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 rounded bg-white/10 hover:bg-white/20 transition"
        >
          Driving Directions →
        </a>
        <a href="/contact" class="px-3 py-1.5 rounded bg-accent hover:bg-accentHover font-bold transition">
          Get Estimate
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/60">
      <div>© 2026 Faber Concrete. All Rights Reserved.</div>
      <div class="flex items-center gap-5">
        <a href="/about" class="hover:text-white">About</a>
        <a href="/reviews" class="hover:text-white">Reviews</a>
        <a href="/policy" class="hover:text-white">Privacy Policy</a>
        <a href="/terms" class="hover:text-white">Terms &amp; Conditions</a>
      </div>
    </div>
  </div>
</footer>
