---
import { SITE, SERVICES, AREAS } from '../data/site';

const counties = AREAS.filter((a) => a.type === 'county');
---

<div class="bg-deep text-white/80 text-xs border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-3">
      <span class="inline-block w-2 h-2 rounded-full bg-gold"></span>
      <span>Farmington Hills, MI · {SITE.region}</span>
    </div>
    <div class="flex items-center gap-4">
      <a href="/reviews" class="hover:text-gold transition">
        ★ {SITE.google.rating.toFixed(1)} ({SITE.google.count} Google Reviews)
      </a>
      <span class="hidden sm:inline text-white/30">|</span>
      <span class="hidden sm:inline text-gold font-semibold">April &amp; May Spring Dates Booking</span>
    </div>
  </div>
</div>

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-deep/10 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3">
      <div class="w-10 h-10 bg-deep text-white font-display font-bold text-xl flex items-center justify-center rounded border-b-4 border-accent">
        FC
      </div>
      <div>
        <div class="font-display font-bold text-xl tracking-tight text-deep uppercase leading-none">
          Faber Concrete
        </div>
        <div class="text-[11px] font-semibold uppercase tracking-wider text-muted mt-0.5">
          5" Driveways · 6" Approaches
        </div>
      </div>
    </a>

    <nav class="hidden lg:flex items-center gap-6 text-sm font-semibold text-deep">
      <div class="relative group py-6">
        <a href="/#services" class="hover:text-accent transition flex items-center gap-1">
          Services <span class="text-xs">▾</span>
        </a>
        <div class="hidden group-hover:block absolute left-0 top-full w-64 bg-white border border-deep/10 shadow-xl rounded-b-lg p-2">
          {SERVICES.map((s) => (
            <a
              href={`/services/${s.slug}`}
              class="block px-3 py-2.5 rounded hover:bg-surface text-deep hover:text-accent transition"
            >
              <div class="font-bold text-sm">{s.title}</div>
              <div class="text-xs text-muted line-clamp-1">{s.highlights[0]}</div>
            </a>
          ))}
        </div>
      </div>

      <div class="relative group py-6">
        <a href="/areas" class="hover:text-accent transition flex items-center gap-1">
          Service Areas <span class="text-xs">▾</span>
        </a>
        <div class="hidden group-hover:block absolute left-0 top-full w-64 bg-white border border-deep/10 shadow-xl rounded-b-lg p-2">
          <a href="/areas" class="block px-3 py-2 rounded hover:bg-surface text-xs font-bold uppercase tracking-wider text-accent">
            All 5 Counties &amp; Cities →
          </a>
          {counties.map((c) => (
            <a
              href={`/areas/${c.slug}`}
              class="block px-3 py-2 rounded hover:bg-surface text-sm text-deep hover:text-accent transition"
            >
              {c.name}
            </a>
          ))}
        </div>
      </div>

      <a href="/calculator" class="hover:text-accent transition">Cost Calculator</a>
      <a href="/guides" class="hover:text-accent transition">Guides</a>
      <a href="/about" class="hover:text-accent transition">About</a>
      <a href="/reviews" class="hover:text-accent transition">Reviews</a>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={SITE.phoneHref}
        class="inline-flex items-center gap-2 px-3 sm:px-4 py-2.5 rounded border border-deep/20 text-deep font-bold text-sm hover:border-accent hover:text-accent transition"
      >
        <span>📞</span>
        <span class="hidden sm:inline">{SITE.phone}</span>
        <span class="sm:hidden">Call</span>
      </a>
      <a
        href="/contact"
        class="inline-flex items-center px-4 sm:px-5 py-2.5 rounded bg-accent hover:bg-accentHover text-white font-bold text-sm shadow transition"
      >
        Request Estimate
      </a>
    </div>
  </div>
</header>
